APP_NAME="Booking App"
APP_ENV=local
APP_KEY=base64:change_me_after_generation
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=booking_app
DB_USERNAME=postgres
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
CACHE_REDIS_HOST=redis
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=null

SESSION_DRIVER=cookie

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@booking.local
MAIL_FROM_NAME="Booking System"

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

STRIPE_PUBLIC_KEY=pk_test_change_me
STRIPE_SECRET_KEY=sk_test_change_me

TWILIO_SID=change_me
TWILIO_TOKEN=change_me
TWILIO_FROM=+1234567890

GOOGLE_APPLICATION_CREDENTIALS=/app/config/google-credentials.json
GOOGLE_CALENDAR_ID=change_me@calendar.google.com
